# GitHub AI Models API
GITHUB_TOKEN=your_github_token_here

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Google AI Studio API (2. AI Validator / Hakem)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Opsiyonel: Model ayarları
GITHUB_MODEL=gpt-4o
PLUGINS_PER_SCAN=15

# NVD - Bilinen CVE eslestirme (gercek CVE bulmak icin)
# API anahtari ucretsiz: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# Tarama sirasinda her plugin icin bilinen CVE kontrolu yapsin mi?
ENABLE_KNOWN_CVE_CHECK=false

# Taint Analysis (TRUE POSITIVE motoru)
ENABLE_TAINT_ANALYSIS=true

# Guvenlik limiti: Maksimum batch sayisi (sonsuz dongu korumasi)
MAX_BATCHES=20

# PoC Dogrulama (Docker ile gercek exploit testi)
ENABLE_POC_VERIFICATION=false
DOCKER_WP_URL=http://localhost:8080

# ========================================
# v4.1 YENİ ÖZELLİKLER
# ========================================

# Paralel Tarama (3x-5x HIZ ARTIŞI!)
ENABLE_PARALLEL_SCAN=true
MAX_PARALLEL_WORKERS=3              # 1.5GB RAM için optimal: 3, 2GB+ için 5
CONCURRENT_DOWNLOADS=3              # Paralel plugin indirme

# False Positive Learning (Machine Learning)
ENABLE_FP_LEARNING=true
FP_PATTERNS_FILE=fp_patterns.json   # Öğrenilen pattern dosyası
